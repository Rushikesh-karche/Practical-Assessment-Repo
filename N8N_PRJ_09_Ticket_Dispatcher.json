ing-top: 12px; border-top: 1px dashed #cbd5e1;\">\n            <span style=\"font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 1px; display: block;\">TICKET REFERENCE</span>\n            <span style=\"font-family: 'Courier New', monospace; font-size: 17px; font-weight: 700; color: #2563eb;\">{{ $('Edit Fields: Data Cleansing & Code Generation').item.json.ticket_code }}</span>\n          </td>\n          <td style=\"padding-top: 12px; border-top: 1px dashed #cbd5e1; text-align: right;\">\n            <span style=\"font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 1px; display: block;\">PASS TYPE</span>\n            <span style=\"display: inline-block; background: #e0e7ff; color: #3730a3; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 4px;\">GENERAL ADMISSION</span>\n          </td>\n        </tr>\n      </table>\n    </div>\n\n    <div style=\"margin-bottom: 22px;\">\n      <h3 style=\"margin: 0 0 12px; font-size: 15px; color: #0f172a;\">📅 Event Schedule & Access Details</h3>\n      <table style=\"width: 100%; border-collapse: collapse; font-size: 13px; color: #475569;\">\n        <tr style=\"border-bottom: 1px solid #f1f5f9;\">\n          <td style=\"padding: 8px 0; font-weight: 600; color: #2563eb; width: 90px;\">09:00 AM</td>\n          <td style=\"padding: 8px 0;\">Doors Open & Badge Collection (Main Kiosks)</td>\n        </tr>\n        <tr style=\"border-bottom: 1px solid #f1f5f9;\">\n          <td style=\"padding: 8px 0; font-weight: 600; color: #2563eb;\">10:00 AM</td>\n          <td style=\"padding: 8px 0;\">Opening Keynote & Industry Trends (Auditorium 1)</td>\n        </tr>\n        <tr style=\"border-bottom: 1px solid #f1f5f9;\">\n          <td style=\"padding: 8px 0; font-weight: 600; color: #2563eb;\">01:30 PM</td>\n          <td style=\"padding: 8px 0;\">Technical Breakouts & Hands-On Automation Labs</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 0; font-weight: 600; color: #2563eb;\">04:30 PM</td>\n          <td style=\"padding: 8px 0;\">Open Networking & Tech Partner Expo</td>\n        </tr>\n      </table>\n    </div>\n\n    <div style=\"background: #f1f5f9; border-radius: 8px; padding: 14px; text-align: center; border: 1px dashed #cbd5e1;\">\n      <p style=\"margin: 0; font-size: 12px; color: #475569;\">Please bring a photo ID and have your ticket reference <strong style=\"color: #0f172a;\">{{ $('Edit Fields: Data Cleansing & Code Generation').item.json.ticket_code }}</strong> ready at registration kiosks.</p>\n    </div>\n  </div>\n  <div style=\"background: #f8fafc; padding: 14px 20px; text-align: center; border-top: 1px solid #e2e8f0;\">\n    <p style=\"margin: 0; font-size: 11px; color: #94a3b8;\">Registered At: {{ $('Edit Fields: Data Cleansing & Code Generation').item.json.registered_at }} UTC • Standard Pass</p>\n  </div>\n</div>",
